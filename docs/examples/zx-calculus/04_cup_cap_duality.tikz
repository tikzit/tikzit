\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (cup_l) at (-1.5, 0.8) {};
		\node [style=none] (cup_r) at (-0.5, 0.8) {};
		\node [style=none] (cup_lbl) at (-1.0, -0.6) {$\eta$ (Cup State)};
		\node [style=none] (cap_l) at (0.8, -0.8) {};
		\node [style=none] (cap_r) at (1.8, -0.8) {};
		\node [style=none] (cap_lbl) at (1.3, 0.6) {$\epsilon$ (Cap Effect)};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=wire, in=-90, out=-90, looseness=2.0] (cup_l) to (cup_r);
		\draw [style=wire, in=90, out=90, looseness=2.0] (cap_l) to (cap_r);
	\end{pgfonlayer}
\end{tikzpicture}
