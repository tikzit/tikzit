---
import fs from 'node:fs';
import path from 'node:path';

const manifestPath = path.resolve('docs/examples/manifest.json');
let corpusDiagrams: Record<string, string> = {};

if (fs.existsSync(manifestPath)) {
  const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
  for (const item of manifest) {
    const num = item.id.slice(0, 2);
    const tikzPath = path.resolve('docs/examples', item.tikz_file);
    if (fs.existsSync(tikzPath)) {
      corpusDiagrams[num] = fs.readFileSync(tikzPath, 'utf8');
    }
  }
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>TikZ WebGL Canvas Runner Test Harness</title>
  <style>
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #0D1117;
    }
    #canvas-container {
      width: 100vw;
      height: 100vh;
      position: relative;
    }
    #webgl-stage {
      display: block;
      width: 100%;
      height: 100%;
    }
  </style>
</head>
<body>
  <div id="canvas-container">
    <canvas id="webgl-stage"></canvas>
  </div>

  <script define:vars={{ corpusDiagrams }}>
    window.__CORPUS_DIAGRAMS__ = corpusDiagrams;
  </script>

  <script>
    import { Stage } from '../../canvas/Stage';
    import { parseTikz } from '../../core/parser/parser';

    declare global {
      interface Window {
        TestCanvas: any;
        __CORPUS_DIAGRAMS__: Record<string, string>;
      }
    }

    const container = document.getElementById('canvas-container') as HTMLElement;
    const stage = new Stage({
      container,
      theme: 'dark',
    });

    window.TestCanvas = {
      stage,
      async loadCorpusDiagram(numStr: string) {
        const paddedId = String(numStr).padStart(2, '0');
        const source = window.__CORPUS_DIAGRAMS__[paddedId];
        if (!source) {
          throw new Error(`Corpus diagram ${paddedId} not found`);
        }
        const ast = parseTikz(source);
        stage.renderGraph(ast);
        stage.fitToGraph();
        return { nodeCount: ast.nodes.length, edgeCount: ast.edges.length };
      },
      getCameraState() {
        return stage.cameraController.getState();
      },
      isSceneReady() {
        return stage.isSceneReady();
      },
      populateStressGraph(count: number) {
        stage.populateStressGraph(count);
      },
      async measureFPSDuringPanZoom(frames: number) {
        return stage.measureFPSDuringPanZoom(frames);
      }
    };
  </script>
</body>
</html>
